<?xml version="1.0" encoding="utf-8"?>
<!--
  FreeANDIY Film MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build filmcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FreeANDIY Film"
      Manufacturer="Free Andy Agency"
      Version="$(var.Version)"
      UpgradeCode="DEA4E6FE-711D-4CFB-A662-1329EBBFE395"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FreeANDIY Film video editor" Manufacturer="Free Andy Agency" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FreeANDIY Film is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://freeandiy.freeandy.agency/film" />
    <Property Id="ARPURLUPDATEINFO" Value="https://freeandiy.freeandy.agency/film" />
    <Property Id="ARPHELPLINK" Value="https://github.com/FreeAndy21/freeandiy-film/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FreeANDIY Film" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FreeANDIY Film" Level="1">
      <ComponentGroupRef Id="FilmcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="EF1DD56F-A973-44C2-9A96-3454ACE80B65">
        <File Id="FilmcraftExe" Source="$(var.BinDir)\freeandiy-film.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FreeANDIY Film"
              Description="FreeANDIY Film video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\freeandiy-film.exe" Value="[#FilmcraftExe]" Type="string" />
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\freeandiy-film-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
